{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    // Dice ASCII art by Joan G. Stark ("jgs"), signature removed for the logo
    // Source: https://www.asciiart.eu/art/5ec4f3e9d111652f
    "source": "~/.config/fastfetch/ascii/dice.ascii",
    "type": "file",
    "height": 20,
    "padding": {
      "bottom": 1,
      "top": 3,
      "left": 3,
      "right": 3,
    },
    "color": {
      "1": "#c0c8d0",
      "2": "#7aaac8",
    },
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "#a8b8c8",
      "title": "#7aaac8",
    },
    "percent": {
      "color": {
        "green": "#7a9fa0",
        "yellow": "#bab08c",
        "red": "#c34143",
      },
    },
  },
  "modules": [
    {
      "key": "╭───────────╮",
      "type": "custom",
    },
    {
      "key": "│  user    │",
      "type": "title",
      "format": "{user-name}",
    },
    {
      "key": "│ 󰇅 hname   │",
      "type": "title",
      "format": "{host-name}",
    },
    {
      "key": "│ 󰅐 uptime  │",
      "type": "uptime",
    },
    {
      "key": "│  distro  │",
      "type": "os",
    },
    {
      "key": "│  kernel  │",
      "type": "kernel",
    },
    {
      "key": "│  wm      │",
      "type": "wm",
    },
    {
      "key": "│  term    │",
      "type": "terminal",
    },
    {
      "key": "│  shell   │",
      "type": "shell",
    },
    {
      "key": "│ 󰍛 cpu     │",
      "type": "cpu",
      "showPeCoreCount": true,
    },
    {
      "key": "│ 󰉉 disk    │",
      "type": "disk",
      "folders": "/",
    },
    {
      "key": "│  memory  │",
      "type": "memory",
    },
    {
      "key": "├───────────┤",
      "type": "custom",
    },
    {
      "key": "│ PC        │",
      "type": "host",
      "format": "{5} {1} ({2})",
    },
    {
      "key": "│ ├ 󰢮 gpu   │",
      "type": "gpu",
      "format": "{1} {2} @ {12}",
    },
    {
      "key": "│ ├ 󰓡 swap  │",
      "type": "swap",
    },
    {
      "key": "│ ├  disp  │",
      "type": "monitor",
      "format": "{width}x{height} px @ {refresh-rate} Hz - {physical-width}x{physical-height} mm ({inch} inches, {ppi} ppi)",
    },
    {
      "key": "│ └  dtime │",
      "type": "command",
      "text": "birth_install=$(stat -f %B /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days",
    },
    {
      "key": "│  colors  │",
      "type": "colors",
      "symbol": "circle",
    },
    {
      "key": "╰───────────╯",
      "type": "custom",
    },
  ],
}
