# skhd — niri binds ported to macOS (Mod = Option/alt), driving OmniWM via omniwmctl
# Source: github.com/JuicyGoose007-coder/dotfiles config/.config/niri/sections/binds.kdl
# Reload: skhd --reload

# ─── Applications ───
alt - return : open -na kitty
alt - b      : open -na Firefox --env MOZ_DISABLE_SAFE_MODE_KEY=1 --args -P main --new-window
alt - s      : open -na kitty --args /opt/homebrew/bin/spf
alt - e      : open "$HOME"
alt - d      : /opt/homebrew/bin/lookapp --toggle
alt - v      : /opt/homebrew/bin/omniwmctl command open-command-palette clipboard
alt - space  : /opt/homebrew/bin/omniwmctl command toggle-overview
cmd - m      : open -a Messages
alt - z      : open -na zen --env MOZ_DISABLE_SAFE_MODE_KEY=1 --args 

# ─── Window Management ───
alt - q         : /opt/homebrew/bin/omniwmctl command close-focused-window
shift + alt - q : $HOME/.local/bin/quitall
shift + alt - f : /opt/homebrew/bin/omniwmctl command toggle-container-full-primary-span
alt - f         : /opt/homebrew/bin/omniwmctl command toggle-fullscreen
shift + alt - t : /opt/homebrew/bin/omniwmctl command toggle-focused-window-floating
shift + alt - v : /opt/homebrew/bin/omniwmctl command toggle-floating-focus
alt - w         : /opt/homebrew/bin/omniwmctl command toggle-column-tabbed

# ─── Focus Navigation ───
alt - left  : /opt/homebrew/bin/omniwmctl command focus left
alt - down  : /opt/homebrew/bin/omniwmctl command focus down
alt - up    : /opt/homebrew/bin/omniwmctl command focus up
alt - right : /opt/homebrew/bin/omniwmctl command focus right
alt - h     : /opt/homebrew/bin/omniwmctl command focus left
alt - j     : /opt/homebrew/bin/omniwmctl command focus down
alt - l     : /opt/homebrew/bin/omniwmctl command focus right

# ─── Window Movement ───
shift + alt - left  : /opt/homebrew/bin/omniwmctl command move-column left
shift + alt - down  : /opt/homebrew/bin/omniwmctl command move-window-down
shift + alt - up    : /opt/homebrew/bin/omniwmctl command move-window-up
shift + alt - right : /opt/homebrew/bin/omniwmctl command move-column right
shift + alt - h     : /opt/homebrew/bin/omniwmctl command move-column left
shift + alt - j     : /opt/homebrew/bin/omniwmctl command move-window-down
shift + alt - k     : /opt/homebrew/bin/omniwmctl command move-window-up
shift + alt - l     : /opt/homebrew/bin/omniwmctl command move-column right

# ─── Column Navigation ───
alt - home        : /opt/homebrew/bin/omniwmctl command focus-column first
alt - end         : /opt/homebrew/bin/omniwmctl command focus-column last
ctrl + alt - home : /opt/homebrew/bin/omniwmctl command move-column-to-first
ctrl + alt - end  : /opt/homebrew/bin/omniwmctl command move-column-to-last

# ─── Monitor Navigation ───
ctrl + alt - left  : /opt/homebrew/bin/omniwmctl command focus-monitor prev
ctrl + alt - right : /opt/homebrew/bin/omniwmctl command focus-monitor next
ctrl + alt - h     : /opt/homebrew/bin/omniwmctl command focus-monitor prev
ctrl + alt - j     : /opt/homebrew/bin/omniwmctl command focus-monitor next
ctrl + alt - k     : /opt/homebrew/bin/omniwmctl command focus-monitor prev
ctrl + alt - l     : /opt/homebrew/bin/omniwmctl command focus-monitor next

# ─── Move to Monitor ───
shift + ctrl + alt - left  : /opt/homebrew/bin/omniwmctl command move-to-monitor left
shift + ctrl + alt - down  : /opt/homebrew/bin/omniwmctl command move-to-monitor down
shift + ctrl + alt - up    : /opt/homebrew/bin/omniwmctl command move-to-monitor up
shift + ctrl + alt - right : /opt/homebrew/bin/omniwmctl command move-to-monitor right
shift + ctrl + alt - h     : /opt/homebrew/bin/omniwmctl command move-to-monitor left
shift + ctrl + alt - j     : /opt/homebrew/bin/omniwmctl command move-to-monitor down
shift + ctrl + alt - k     : /opt/homebrew/bin/omniwmctl command move-to-monitor up
shift + ctrl + alt - l     : /opt/homebrew/bin/omniwmctl command move-to-monitor right

# ─── Workspace Navigation ───
alt - pagedown    : /opt/homebrew/bin/omniwmctl command switch-workspace next
alt - pageup      : /opt/homebrew/bin/omniwmctl command switch-workspace prev
alt - u           : /opt/homebrew/bin/omniwmctl command switch-workspace next
alt - k           : /opt/homebrew/bin/omniwmctl command switch-workspace prev
ctrl + alt - down : /opt/homebrew/bin/omniwmctl command move-column-to-workspace down
ctrl + alt - up   : /opt/homebrew/bin/omniwmctl command move-column-to-workspace up
ctrl + alt - u    : /opt/homebrew/bin/omniwmctl command move-column-to-workspace down
ctrl + alt - i    : /opt/homebrew/bin/omniwmctl command move-column-to-workspace up

# ─── Named Workspaces (1=Main, 2=Media, 3, 4-8, 9=Discord) ───
alt - m : /opt/homebrew/bin/omniwmctl command switch-workspace 1
alt - g : /opt/homebrew/bin/omniwmctl command switch-workspace 2
alt - n : /opt/homebrew/bin/omniwmctl command switch-workspace 3
alt - 4 : /opt/homebrew/bin/omniwmctl command switch-workspace 4
alt - 5 : /opt/homebrew/bin/omniwmctl command switch-workspace 5
alt - 6 : /opt/homebrew/bin/omniwmctl command switch-workspace 6
alt - 7 : /opt/homebrew/bin/omniwmctl command switch-workspace 7
alt - 8 : /opt/homebrew/bin/omniwmctl command switch-workspace 8
alt - 9 : /opt/homebrew/bin/omniwmctl command switch-workspace 9
alt - i : /opt/homebrew/bin/omniwmctl command switch-workspace 9

shift + alt - m : /opt/homebrew/bin/omniwmctl command move-column-to-workspace 1
shift + alt - g : /opt/homebrew/bin/omniwmctl command move-column-to-workspace 2
shift + alt - n : /opt/homebrew/bin/omniwmctl command move-column-to-workspace down
shift + alt - 4 : /opt/homebrew/bin/omniwmctl command move-column-to-workspace 4
shift + alt - 5 : /opt/homebrew/bin/omniwmctl command move-column-to-workspace 5
shift + alt - 6 : /opt/homebrew/bin/omniwmctl command move-column-to-workspace 6
shift + alt - 7 : /opt/homebrew/bin/omniwmctl command move-column-to-workspace 7
shift + alt - 8 : /opt/homebrew/bin/omniwmctl command move-column-to-workspace 8
shift + alt - 9 : /opt/homebrew/bin/omniwmctl command move-column-to-workspace 9
shift + alt - i : /opt/homebrew/bin/omniwmctl command move-column-to-workspace 9

# ─── Column Management ───
alt - 0x21 : /opt/homebrew/bin/omniwmctl command consume-or-expel-window-left
alt - 0x1E : /opt/homebrew/bin/omniwmctl command consume-or-expel-window-right
alt - 0x2F : /opt/homebrew/bin/omniwmctl command expel-window-from-column

# ─── Sizing & Layout ───
alt - r         : /opt/homebrew/bin/omniwmctl command cycle-size forward
shift + alt - r : /opt/homebrew/bin/omniwmctl command cycle-window-secondary-span forward
ctrl + alt - r  : /opt/homebrew/bin/omniwmctl command reset-window-secondary-span
ctrl + alt - f  : /opt/homebrew/bin/omniwmctl command expand-container-to-available-primary-span
alt - c         : /opt/homebrew/bin/omniwmctl command center-column
ctrl + alt - c  : /opt/homebrew/bin/omniwmctl command center-visible-columns

# ─── Manual Sizing ───
alt - 0x1B         : /opt/homebrew/bin/omniwmctl command set-container-primary-span -10%
alt - 0x18         : /opt/homebrew/bin/omniwmctl command set-container-primary-span +10%
shift + alt - 0x1B : /opt/homebrew/bin/omniwmctl command set-window-secondary-span -10%
shift + alt - 0x18 : /opt/homebrew/bin/omniwmctl command set-window-secondary-span +10%

# ─── Screenshots ───
alt - p          : screencapture -i "$HOME/Pictures/Screenshots/shot-$(date +%Y%m%d-%H%M%S).png"
ctrl + shift - p : screencapture -c "$HOME/Pictures/Screenshots/shot-$(date +%Y%m%d-%H%M%S).png"
ctrl + shift - w : screencapture -iW "$HOME/Pictures/Screenshots/shot-$(date +%Y%m%d-%H%M%S).png"

# ─── Power ───
shift + alt - p : pmset displaysleepnow
